# Dockerfile for osxphotos Linux test environment
# This creates a cached image with all dependencies pre-installed
# Build for specific Python version: docker build --build-arg PYTHON_VERSION=3.14 -t osxphotos-test:3.14 -f scripts/Dockerfile.linux-tests .

ARG PYTHON_VERSION=3.14
FROM python:${PYTHON_VERSION}

# Install system dependencies
RUN apt-get update && apt-get install -y \
    exiftool \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Set working directory
WORKDIR /workspace

# Keep the virtual environment outside /workspace, which is mounted from the host at run time
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_PYTHON=/usr/local/bin/python

# Copy dependency metadata
COPY pyproject.toml uv.lock ./

# Install Python dependencies (runtime + dev group) as pinned in uv.lock.
# --no-install-project skips osxphotos itself; run_linux_tests.sh mounts the
# source at /workspace and runs pytest from there, so the working tree provides the package.
RUN uv sync --locked --no-install-project

# Default command
CMD ["/bin/bash"]
